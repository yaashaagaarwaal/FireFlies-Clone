DATABASE_URL=sqlite:///./fireflies.db
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Optional. Leave blank to use the built-in heuristic meeting-summary
# generator (no external calls, works out of the box). Set this to a real
# key to have Claude generate summaries/topics/action items from transcript
# text instead — requires `pip install anthropic`.
ANTHROPIC_API_KEY=
